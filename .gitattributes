# Normalização de fim de linha.
#
# O índice deste repositório guarda TUDO em LF (verificado: zero blobs com CRLF).
# Este arquivo garante que o CHECKOUT também produza LF, independentemente do
# core.autocrlf da máquina. Sem ele, o Git para Windows (autocrlf=true por padrão
# no instalador) converteria android/gradlew para CRLF, quebrando o build POSIX.
#
# Atributos vencem core.autocrlf, então isto vale para todos sem configuração local.

# --- Padrão: detecta texto automaticamente, sempre grava LF no worktree ---
* text=auto eol=lf

# --- Exceções que PRECISAM de CRLF (interpretadores do Windows) ---
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- Exceções que PRECISAM de LF (scripts POSIX) ---
*.sh    text eol=lf
gradlew text eol=lf

# Coberto por *.bat acima; explicitado porque quebrar o wrapper do Gradle
# é caro de diagnosticar.
gradlew.bat text eol=crlf

# --- Binários: nunca converter, nunca tentar diff textual ---
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.pdf      binary
*.jar      binary
*.apk      binary
*.aab      binary
*.keystore binary
*.jks      binary
*.p12      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.zip      binary
*.tgz      binary
*.hprof    binary

# --- Gerados: colapsa o diff no GitHub e some das estatísticas de linguagem ---
src/integrations/supabase/types.ts linguist-generated=true
package-lock.json                  linguist-generated=true
