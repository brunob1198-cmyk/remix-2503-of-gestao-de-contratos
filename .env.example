# Copie este arquivo para `.env` e preencha com os valores do seu projeto Supabase.
# O `.env` não é versionado (ver .gitignore).
#
# Onde encontrar: painel do Supabase > Project Settings > API

# --- Frontend (Vite) ---
# Apenas variáveis com prefixo VITE_ são expostas ao bundle do navegador.
# A chave "publishable"/anon é pública por design; a proteção real dos dados
# vem das políticas de Row Level Security (RLS) no banco.
# NUNCA coloque a chave `service_role` aqui — ela ignora o RLS.
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
VITE_SUPABASE_PROJECT_ID=<project-id>

# --- Edge Functions (desenvolvimento local) ---
# Em produção o Supabase injeta estas variáveis automaticamente no runtime das
# functions; só são necessárias aqui para rodar `supabase functions serve`.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
